<%- include("partials/header") %>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-1"><i class="bi bi-envelope"></i> Contact</h1>
                    <p class="text-muted">Send a message to the owner of the site.</p>
                    <form method="post" action="/contact" novalidate>
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control<%= errors.name ? ' is-invalid' : '' %>" id="name" name="name" value="<%= form.name %>" maxlength="80" required>
                            <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control<%= errors.email ? ' is-invalid' : '' %>" id="email" name="email" value="<%= form.email %>" maxlength="120" required>
                            <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
                        </div>
                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" class="form-control<%= errors.subject ? ' is-invalid' : '' %>" id="subject" name="subject" value="<%= form.subject %>" maxlength="120" required>
                            <% if (errors.subject) { %><div class="invalid-feedback"><%= errors.subject %></div><% } %>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control<%= errors.message ? ' is-invalid' : '' %>" id="message" name="message" rows="6" maxlength="2000" required><%= form.message %></textarea>
                            <% if (errors.message) { %><div class="invalid-feedback"><%= errors.message %></div><% } %>
                        </div>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include("partials/footer") %>