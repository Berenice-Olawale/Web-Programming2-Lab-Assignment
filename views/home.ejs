<%- include("partials/header") %>

<section class="hero text-white">
    <div class="container py-5">
        <div class="row align-items-center gy-4 py-lg-4">
            <div class="col-lg-6">
                <span class="badge rounded-pill bg-light text-primary mb-3">Refurbished &bull; Tested &bull; Affordable</span>
                <h1 class="display-4 fw-bold">Give great notebooks a second life.</h1>
                <p class="lead mb-4">
                    <%= site.name %> collects, checks and resells quality notebooks. Browse the whole
                    stock with every processor and operating system listed &ndash; nothing hidden.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/database" class="btn btn-light btn-lg text-primary"><i class="bi bi-laptop"></i> Browse the database</a>
                    <% if (!user) { %>
                    <a href="/register" class="btn btn-outline-light btn-lg"><i class="bi bi-person-plus"></i> Create an account</a>
                    <% } else { %>
                    <a href="/contact" class="btn btn-outline-light btn-lg"><i class="bi bi-envelope"></i> Contact us</a>
                    <% } %>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="/img/hero-notebook.jpg" alt="ReNew Notebooks: refurbished, tested, affordable" class="img-fluid rounded-4 hero-img shadow-lg">
            </div>
        </div>
    </div>
</section>

<% if (dbError) { %>
<div class="container mt-4">
    <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle"></i> The live numbers are temporarily unavailable.</div>
</div>
<% } %>

<section class="container stats-band">
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100"><div class="card-body">
                <div class="stat-number" data-count="<%= stats.notebooks %>"><%= stats.notebooks %></div>
                <div class="text-muted">notebook models</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100"><div class="card-body">
                <div class="stat-number" data-count="<%= stats.pieces %>"><%= stats.pieces %></div>
                <div class="text-muted">pieces in stock</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100"><div class="card-body">
                <div class="stat-number" data-count="<%= stats.brands %>"><%= stats.brands %></div>
                <div class="text-muted">brands</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card shadow-sm h-100"><div class="card-body">
                <div class="stat-number" data-count="<%= stats.processors %>"><%= stats.processors %></div>
                <div class="text-muted">processor types</div>
            </div></div>
        </div>
    </div>
</section>

<section class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Why ReNew?</h2>
        <p class="text-muted">A reused notebook is cheaper for you and better for the planet.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <img src="/img/gallery-repair.jpg" class="card-img-top" alt="Quality check: cleaned and tested">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-check2-circle text-primary"></i> Cleaned and tested</h5>
                    <p class="card-text">Every notebook goes through a quality check before it is offered.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center text-center py-5">
                    <div class="feature-icon mb-3"><i class="bi bi-cpu"></i></div>
                    <h5 class="card-title">Transparent specifications</h5>
                    <p class="card-text">Display, memory, disk, video controller, processor and operating system for every model.</p>
                    <a href="/database" class="btn btn-outline-primary mt-2 align-self-center">See the specs</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card feature-card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center text-center py-5">
                    <div class="feature-icon mb-3"><i class="bi bi-recycle"></i></div>
                    <h5 class="card-title">Good for the planet</h5>
                    <p class="card-text">Reusing a notebook keeps electronics out of the waste bin and saves money.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<% if (featured.length) { %>
<section class="deals-band py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <h2 class="fw-bold mb-0">Best deals in stock</h2>
                <div class="text-muted">The three cheapest notebooks that are available right now</div>
            </div>
            <a href="/database?stock=1&amp;sort=price_asc" class="btn btn-primary">All notebooks in stock <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            <% featured.forEach(function (n) { %>
            <div class="col-md-4">
                <div class="card deal-card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="badge bg-primary"><%= n.manufacturer %></span>
                            <span class="badge bg-success"><%= n.pieces %> in stock</span>
                        </div>
                        <h5 class="card-title mt-3"><%= n.type %></h5>
                        <ul class="list-unstyled small text-muted mb-3">
                            <li><i class="bi bi-display"></i> <%= fmtDisplay(n.display) %> display</li>
                            <li><i class="bi bi-memory"></i> <%= fmtMemory(n.memory) %> memory, <%= fmtDisk(n.harddisk) %> disk</li>
                            <li><i class="bi bi-cpu"></i> <%= n.processor ? n.processor.manufacturer + ' ' + n.processor.type : 'n/a' %></li>
                            <li><i class="bi bi-windows"></i> <%= n.opsystem ? n.opsystem.name : 'n/a' %></li>
                        </ul>
                        <div class="fs-4 fw-bold text-primary"><%= fmtPrice(n.price) %></div>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<% if (brands.length) { %>
<section class="container my-5 text-center">
    <h2 class="fw-bold mb-3">Browse by brand</h2>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <% brands.forEach(function (b) { %>
        <a class="btn btn-outline-primary rounded-pill" href="/database?manufacturer=<%= encodeURIComponent(b) %>"><%= b %></a>
        <% }); %>
    </div>
</section>
<% } %>

<% if (!user) { %>
<section class="cta-band text-white text-center py-5">
    <div class="container">
        <h2 class="fw-bold">Want to see more?</h2>
        <p class="lead">Register for free to read the messages and open the graphs.</p>
        <a href="/register" class="btn btn-light btn-lg text-primary me-2">Registration</a>
        <a href="/login" class="btn btn-outline-light btn-lg">Login</a>
    </div>
</section>
<% } %>

<script>
// numbers count up when the page opens (the real numbers are already in the HTML)
document.querySelectorAll('.stat-number[data-count]').forEach(function (el) {
    var target = parseInt(el.dataset.count, 10);
    if (!target || target < 1) return;
    var start = null;
    function step(ts) {
        if (start === null) start = ts;
        var p = Math.min(1, (ts - start) / 900);
        el.textContent = Math.round(target * p).toLocaleString('en-US');
        if (p < 1) requestAnimationFrame(step); else el.textContent = target.toLocaleString('en-US');
    }
    requestAnimationFrame(step);
});
</script>

<%- include("partials/footer") %>
