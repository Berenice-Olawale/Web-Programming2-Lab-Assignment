</main>
<footer class="site-footer bg-dark text-light mt-5 py-4">
    <div class="container">
        <div class="row gy-3">
            <div class="col-md-6">
                <div class="fw-bold"><%= site.name %></div>
                <div class="small text-white-50"><%= site.tagline %></div>
                <div class="small text-white-50 mt-2">
                    Theme: <a class="link-light" href="<%= site.themeUrl %>">Bootswatch <%= site.theme.charAt(0).toUpperCase() + site.theme.slice(1) %></a> (Bootstrap 5)
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="small text-white-50 mb-1">Created by</div>
                <% site.creators.forEach(function (c) { %>
                <div><%= c.name %> <span class="text-white-50">&ndash; Neptun: <%= c.neptun %></span></div>
                <% }); %>
            </div>
        </div>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
