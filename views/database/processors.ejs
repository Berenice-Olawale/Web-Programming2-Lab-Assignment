<%- include("../partials/header") %>
<div class="container py-4">
    <h1 class="h3 mb-1">Database</h1>
    <p class="text-muted">The <strong>processors</strong> collection and how many notebooks use each processor.</p>
    <%- include("_tabs") %>
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary"><tr><th>Manufacturer</th><th>Type</th><th class="text-end">Notebooks</th><th></th></tr></thead>
            <tbody>
                <% rows.forEach(function (p) { %>
                <tr>
                    <td class="fw-semibold"><%= p.manufacturer %></td>
                    <td><%= p.type %></td>
                    <td class="text-end"><span class="badge bg-<%= p.count ? 'primary' : 'secondary' %>"><%= p.count %></span></td>
                    <td class="text-end"><% if (p.count) { %><a class="btn btn-sm btn-outline-primary" href="/database?processor=<%= p._id %>">Show notebooks</a><% } %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>
<%- include("../partials/footer") %>
