<%- include("../partials/header") %>
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-0"><i class="bi bi-pencil-square"></i> CRUD: notebooks</h1>
            <p class="text-muted mb-0">Create, read, update and delete notebooks (administrators only). Total: <strong><%= items.length %></strong></p>
        </div>
        <a href="/crud/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New notebook</a>
    </div>
    <% if (items.length === 0) { %>
    <div class="alert alert-info">There are no notebooks yet.</div>
    <% } else { %>
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th>Brand</th><th>Model</th><th>Display</th><th>Memory</th><th>Disk</th>
                    <th>Processor</th><th>Operating system</th><th class="text-end">Price</th><th>Stock</th><th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(function (n) { %>
                <tr>
                    <td class="fw-semibold"><%= n.manufacturer %></td>
                    <td><%= n.type %></td>
                    <td><%= fmtDisplay(n.display) %></td>
                    <td><%= fmtMemory(n.memory) %></td>
                    <td><%= fmtDisk(n.harddisk) %></td>
                    <td><%= n.processor ? n.processor.manufacturer + ' ' + n.processor.type : '-' %></td>
                    <td><%= n.opsystem ? n.opsystem.name : '-' %></td>
                    <td class="text-end text-nowrap"><%= fmtPrice(n.price) %></td>
                    <td><%= n.pieces %></td>
                    <td class="text-end text-nowrap">
                        <a href="/crud/<%= n._id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                        <form method="post" action="/crud/<%= n._id %>/delete" class="d-inline" onsubmit="return confirm('Delete this notebook?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                        </form>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>
<%- include("../partials/footer") %>