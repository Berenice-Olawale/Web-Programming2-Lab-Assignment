# Copy this file to ".env" and fill in your own values. ".env" is in .gitignore.
# On Render add the same keys under  Environment -> Environment Variables.

# Atlas connection string (Database -> Connect -> Drivers), with your real password in it
MONGODB_PASSW=mongodb+srv://<db_username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority

# Long random text used to sign the session cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: database name (default: renew)
# DB_NAME=renew

# Only used by "npm run seed" to create the admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
