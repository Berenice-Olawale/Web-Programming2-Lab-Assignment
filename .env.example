# Copy this file to ".env" (same folder) and fill in your own value.
# ".env" is listed in .gitignore, so it is NOT uploaded to GitHub.
# On Render you set the same key under  Environment -> Environment Variables.

# Atlas connection string: Database -> Clusters -> Connect -> Drivers
# Replace <password> with your database user's password.
MONGODB_PASSW=mongodb+srv://<db_username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority

# Optional: database name (default: web2). The collection is "users".
# DB_NAME=web2
